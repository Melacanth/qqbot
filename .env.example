# =========================================================
# 路径配置
# PROJECT_ROOT 自动取项目目录，不需要配置。
# DATA_DIR 和 LOG_DIR 相对 PROJECT_ROOT。
# DATABASE_PATH、IMAGE_ROOT、SUMMARY_IMAGE_DIR 和 KEYWORD_LOCAL_CONFIG_PATH
# 相对 DATA_DIR；SUMMARY_FONT_PATH 和 KEYWORD_CONFIG_PATH 相对 PROJECT_ROOT。
# 所有路径均可填写绝对路径，以适配不同机器。
# Windows 示例：DATA_DIR=D:/qq-deepseek-bot/data
# Linux 示例：DATA_DIR=/home/pi/qq-deepseek-bot/data
# =========================================================
DATA_DIR=data
LOG_DIR=logs
DATABASE_PATH=bot_state.db
IMAGE_ROOT=../image_library
SUMMARY_IMAGE_DIR=generated_summaries
# 留空时自动检测 Windows/Linux 常见中文字体。
SUMMARY_FONT_PATH=
KEYWORD_CONFIG_PATH=keyword_triggers.json
KEYWORD_LOCAL_CONFIG_PATH=keyword_triggers.local.json

# =========================================================
# DeepSeek
# =========================================================
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=2

# =========================================================
# NapCat WebSocket
# =========================================================
# 留空时默认连接 ws://127.0.0.1:3001
# 远程 NapCat 示例：NAPCAT_WS_URL=ws://192.168.1.100:3001
NAPCAT_WS_URL=
NAPCAT_WS_TOKEN=

# =========================================================
# VLM（预留配置；默认不改变现有 OCR 图片解析链路）
# 留空时 API Key 和 Base URL 继承 DeepSeek 配置。
# =========================================================
VLM_ENABLED=false
VLM_API_KEY=
VLM_BASE_URL=
VLM_MODEL=
VLM_MAX_TOKENS=1600

# =========================================================
# Tavily 联网搜索
# =========================================================
TAVILY_API_KEY=
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_CACHE_MINUTES=20
WEB_SEARCH_MAX_CONTENT_CHARS=1800
TAVILY_TIMEOUT_SECONDS=15

# =========================================================
# OCR
# 留空时 Windows 自动查找 tesseract.exe，并回退到标准安装目录；
# Linux 自动查找 PATH，并回退到 /usr/bin/tesseract。
# Windows 手动配置示例：
# IMAGE_OCR_TESSERACT_CMD="C:/Program Files/Tesseract-OCR/tesseract.exe"
# Linux 手动配置示例：IMAGE_OCR_TESSERACT_CMD=/usr/bin/tesseract
# OCR_TEMP_DIR 留空时使用系统临时目录。
# =========================================================
IMAGE_OCR_TESSERACT_CMD=
OCR_TEMP_DIR=
IMAGE_OCR_LANGS=chi_sim+eng
IMAGE_OCR_MAX_BYTES=10485760
IMAGE_OCR_USE_OPENCV=true
IMAGE_OCR_MAX_SIDE=1800
IMAGE_OCR_PSMS=6,11
IMAGE_OCR_DEBUG_SAVE=false

# =========================================================
# 图片与摘要
# =========================================================
IMAGE_MAX_BYTES=10485760
SUMMARY_IMAGE_WIDTH=1080
SUMMARY_IMAGE_MAX_HEIGHT=2000
SUMMARY_IMAGE_THEME=dark
SUMMARY_MAX_TOKENS=1600
SUMMARY_DETAIL_LEVEL=detailed

# =========================================================
# 机器人权限、模式与群聊记忆
# =========================================================
ALLOWED_GROUP_IDS=
ADMIN_USER_IDS=
IMAGE_BLACKLIST_USER_IDS=
THINKING_WHITELIST_USER_IDS=
TRIGGER_PREFIX=/ai
COOLDOWN_SECONDS=5

THINKING_MAX_TOKENS=2400
THINKING_DAILY_FREE_LIMIT=5
THINKING_REASONING_EFFORT=high

PRO_MODEL=deepseek-v4-pro
PRO_DAILY_LIMIT=10
PRO_MAX_TOKENS=2600
PRO_REASONING_EFFORT=high

GROUP_MEMORY_LIMIT=500
GROUP_MEMORY_RETENTION_DAYS=7
GROUP_MEMORY_CONTEXT_LIMIT=80
GROUP_MEMORY_CONTEXT_MAX_CHARS=12000
GROUP_MEMORY_MESSAGE_MAX_CHARS=500

STYLE_SAMPLE_LIMIT=100
STYLE_REFRESH_MIN_MESSAGES=40
STYLE_REFRESH_MINUTES=30
